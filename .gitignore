# Environments
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Secrets
.env

# Data (raw/processed datasets are large and/or have redistribution restrictions —
# document provenance in DATASET_SELECTION.md instead of committing the data itself)
data/raw/*
data/processed/*
data/splits/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep

# Trained model weights (large binary artifacts — track configs/metrics, not weights)
models/*.pt
models/*.pth
models/*.bin
models/*.safetensors

# Logs / scratch
pip_install.log
*.log
experiments/results/*.tmp

# OS
Thumbs.db
.DS_Store

# Local tooling state
.claude/
.pytest_cache/

# Study 2 cached features/predictions (~790MB, regenerable via research_paper_v2/src/01-07)
research_paper_v2/data/processed/*
research_paper_v2/data/raw/*
!research_paper_v2/data/raw/download_summary.json

# Files the deployed Streamlit demo needs at runtime (small; everything else stays ignored)
!data/processed/mvsa_single_manifest.csv
!data/processed/distilbert_embeddings.npz
!data/processed/resnet18_embeddings.npz
