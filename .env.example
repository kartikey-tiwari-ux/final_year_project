# Copy this file to .env and fill in real values. Never commit the real .env file.

# Only needed if the selected dataset's download requires authenticated access
# (e.g. a Kaggle API token). Leave blank if the final dataset source doesn't need one.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Local paths (defaults shown; override if you relocate data/model storage)
DATA_DIR=./data
MODELS_DIR=./models

# Streamlit app config
APP_PORT=8501
